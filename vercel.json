{
  "rewrites": [
    {
      "source": "/for/:client/:who",
      "destination": "/for/:client/"
    },
    {
      "source": "/handover/:client/:who",
      "destination": "/handover/:client/"
    }
  ],
  "redirects": [
    {
      "source": "/one",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/one/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
